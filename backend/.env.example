# Backend Environment Variables
# Copy this file to .env for local development (never commit .env)

# The port the server listens on.
# Render, Railway, and Fly.io set PORT automatically — you do not need to set this manually on those platforms.
PORT=3000

# Comma-separated list of allowed CORS origins.
# Leave unset (or set to *) to allow all origins — fine for a public demo.
# In production, restrict to your Vercel frontend URL:
# CORS_ORIGIN=https://your-frontend.vercel.app
CORS_ORIGIN=*
